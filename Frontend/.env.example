# FastAPI backend base URL (include /api/v1 — no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
VITE_API_TIMEOUT_MS=120000

# Optional Google Identity Services client ID (public). Leave empty to hide Google sign-in.
# Must match Backend GOOGLE_OAUTH_CLIENT_ID.
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
